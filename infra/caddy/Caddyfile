{$DOMAIN} {
	encode zstd gzip

	# a bit above the app's own 25 MB body limit (assignment/submission files)
	request_body {
		max_size 26MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# the student page needs the camera and the location
		Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
		-Server
	}

	# caddy replaces any client-sent X-Forwarded-For with the real peer address
	reverse_proxy app:8080
}
